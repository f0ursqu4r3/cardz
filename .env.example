# Frontend WebSocket URL (set this in Railway for production)
# For Railway, this should be: wss://your-service-name.railway.app
VITE_WS_URL=ws://localhost:9001

# Server port (Railway sets this automatically)
PORT=9001

# Admin password for accessing the server admin panel (/admin route)
# Must be at least 8 characters. Leave empty to disable admin panel.
ADMIN_PASSWORD=
